[user]
  email = undydisc@gmail.com
  name = Underdisc

[core]
  autocrlf = input
  editor = nvim
  pager = cat

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
  line-fill-method = spaces
  file-style = omit
  syntax-theme = Visual Studio Dark+
  hunk-label = 
  hunk-header-decoration-style = ''
  hunk-header-style = line-number blue bold italic
  hunk-header-line-number-style = blue
  plus-style = syntax "#113311"
  plus-emph-style = syntax "#115511"
  minus-style = syntax "#441111"
  minus-emph-style = syntax "#771111"

[merge]
  conflictStyle = zdiff3

[alias]
  #SHORTENED COMMANDS
  b = branch
  cm = commit -m
  co = checkout
  d = diff --color=always
  ds = diff --submodule=log
  s = status --ignore-submodules=none
  vommit = commit -m \":O~==~ This is broken\"
  view = "!f() { git diff $1~1 $1 $2 $3; }; f"
  reverseview = "!f() { git diff $1 $1~1 $2 $3; }; f"
  applycommit = "!f() { git view $1 > p; git apply p; rm p; }; f"
  stripcommit = "!f() { git reverseview $1 > p; git apply p; rm p; }; f"

  wc = commit -m "wc"
  awc = !git add . && git commit -m "wc" && :
  rwc = !git reset HEAD~1

[status]
  submoduleSummary = true

[pull]
  rebase = false

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[init]
  defaultBranch = master
